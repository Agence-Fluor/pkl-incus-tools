#!/usr/bin/env -S bash -ec 'd=${0%/*};r=$d/.pkl-nix-tools;test ! -L "$r";test -f "$r/run"||{ mkdir -p "$r";echo "*" >"$r/.gitignore";pkl eval -w "$d" -x launcher flake.pkl -o ".pkl-nix-tools/run.$$";mv "$r/run.$$" "$r/run";};exec bash "$r/run" "$0" "$@"'
amends "@nix/Flake.pkl"

import "@nix/Nix.pkl" as Nix

local launcher = import("@nixTools/Bootstrap.pkl").output.text

description = "Toolchain for the pkl-incus-tools package"

inputs {
  ["nixpkgs"] = new Nix.Input { url = "github:NixOS/nixpkgs/nixos-unstable" }
}

local systems = List("x86_64-linux", "aarch64-linux")

devShells {
  for (system in systems) {
    [system] {
      ["default"] = new Nix.MkShell {
        pkgs = new Nix.Ref { path = "inputs.nixpkgs.legacyPackages.\(system)" }
        packages { "pkl"; "incus.client"; "unzip" }
        shellHook = new Nix.InterpolatedString {
          parts { "export PKL=\""; new Nix.Ref { path = "pkgs.pkl" }; "/bin/pkl\"\n" }
        }
      }
    }
  }
}
