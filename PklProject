amends "pkl:Project"

package {
  name = "pkl-incus-tools"
  baseUri = "package://pkg.pkl-lang.org/github.com/Agence-Fluor/pkl-incus-tools/pkl-incus-tools"
  version = "0.1.3"
  packageZipUrl =
    "https://github.com/Agence-Fluor/pkl-incus-tools/releases/download/pkl-incus-tools@\(version)/pkl-incus-tools@\(version).zip"
  sourceCode = "https://github.com/Agence-Fluor/pkl-incus-tools"
}

dependencies {
  ["nixTools"] {
    uri = "package://pkg.pkl-lang.org/github.com/Agence-Fluor/pkl-nix-tools/pkl-nix-tools@0.2.0"
  }
  ["nix"] {
    uri = "package://pkg.pkl-lang.org/github.com/Agence-Fluor/pkl-nix/pkl-nix@0.1.2"
  }
  ["incus"] {
    uri = "package://pkg.pkl-lang.org/github.com/Agence-Fluor/pkl-incus/incus-pkl@0.1.2"
  }
  ["shell"] {
    uri = "package://pkg.pkl-lang.org/github.com/Agence-Fluor/pkl-shell/pkl-shell@0.1.1"
  }
}

evaluatorSettings {
  moduleCacheDir = ".pkl-cache"
}
